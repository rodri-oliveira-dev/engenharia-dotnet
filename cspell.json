{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "pt,pt_BR,en",
  "import": [
    "@cspell/dict-pt-br/cspell-ext.json"
  ],
  "dictionaryDefinitions": [
    {
      "name": "engenharia-dotnet-termos-tecnicos",
      "path": "./.cspell/termos-tecnicos.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "engenharia-dotnet-termos-tecnicos"
  ],
  "caseSensitive": false,
  "minWordLength": 4,
  "ignoreRegExpList": [
    "/https?:\\/\\/[^\\s)]+/g",
    "/`+[^`]*`+/g"
  ]
}
